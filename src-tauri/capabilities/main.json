{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local presentation may call only the controller's narrow typed commands.",
  "windows": ["main"],
  "permissions": [
    "allow-app-snapshot", "allow-save-notification-policy", "allow-control-service",
    "allow-begin-pairing", "allow-remove-device", "allow-decide-request",
    "allow-clear-activity", "allow-open-lock-settings", "allow-open-notification-settings",
    "allow-open-pairing-scanner", "allow-request-details", "allow-set-relay"
  ]
}
