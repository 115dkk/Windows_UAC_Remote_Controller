{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local presentation may call only the controller's narrow typed commands.",
  "windows": ["main"],
  "permissions": [
    "allow-get-language", "allow-set-language",
    "allow-app-snapshot", "allow-save-notification-policy", "allow-control-service",
    "allow-begin-pairing", "allow-begin-pairing-usb", "allow-remove-device", "allow-decide-request",
    "allow-clear-activity", "allow-open-diagnostics-folder", "allow-open-lock-settings", "allow-open-notification-settings",
    "allow-open-pairing-scanner", "allow-open-pairing-usb", "allow-export-android-diagnostics", "allow-request-details", "allow-set-relay",
    "allow-taskbar-offer", "allow-request-taskbar-pin"
  ]
}
