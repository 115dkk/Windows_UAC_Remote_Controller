simplify
solve( !RequestOrigin( request_id, pc, binding )[+] ▶₁ #c )
  case OpenActualRequest
  solve( !RequestOrigin( request_id.1, ~pc,
                         <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id, ~nonce,
                          ~content_digest, ~expiry>
         )[+] ▶₁ #o )
    case OpenActualRequest
    solve( RequestAccepted( ~pc, device, revision,
                            <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id, ~nonce,
                             ~content_digest, ~expiry>,
                            'approve'
           ) @ #a )
      case AcceptApproval
      solve( !RequestOrigin( request_id, ~pc,
                             <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id.1, ~nonce,
                              ~content_digest, ~expiry>
             )[+] ▶₂ #a )
        case OpenActualRequest
        solve( Enrolled( ~pc, device, revision, approval_key.2, denial_key.3
               ) @ #e )
          case TrustedEnrollment
          solve( !EnrollmentKeys( ~pc, ~device, approval_key, denial_key.1
                 ) ▶₃ #c )
            case TrustedEnrollment
            solve( RequestSlot( ~request_id, ~pc,
                                <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id, ~nonce,
                                 ~content_digest, ~expiry>,
                                'building'
                   ) ▶₀ #o )
              case CaptureEligibleDevice
              solve( !Snapshot( ~pc, device.1, revision.1, approval_key, denial_key.1,
                                <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id, ~nonce,
                                 ~content_digest, ~expiry>
                     ) ▶₂ #o )
                case CaptureEligibleDevice
                solve( !PhoneKeys( ~device, approval_sk.2, denial_sk.1 ) ▶₀ #u )
                  case TrustedEnrollment
                  solve( ApprovalTicket( ~device,
                                         <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id, ~nonce,
                                          ~content_digest, ~expiry>,
                                         approval_sk.1
                         ) ▶₀ #s )
                    case UserAuthenticatesExactApproval
                    solve( !EnrollmentKeys( ~pc, ~device, pk(x), denial_key ) ▶₁ #a )
                      case TrustedEnrollment
                      solve( !Snapshot( ~pc, ~device, ~revision, pk(~approval_sk),
                                        pk(~denial_sk),
                                        <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id, ~nonce,
                                         ~content_digest, ~expiry>
                             ) ▶₃ #a )
                        case CaptureEligibleDevice
                        solve( RequestSlot( ~request_id, ~pc,
                                            <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id, ~nonce,
                                             ~content_digest, ~expiry>,
                                            'pending'
                               ) ▶₄ #a )
                          case PublishRequest
                          solve( RequestSlot( ~request_id, ~pc,
                                              <~pc, ~epoch, ~session_id, ~logon_luid, ~request_id, ~nonce,
                                               ~content_digest, ~expiry>,
                                              'building'
                                 ) ▶₀ #c )
                            case OpenActualRequest
                            solve( RegistrySlot( ~device, ~pc, ~revision, 'active' ) ▶₂ #c )
                              case TrustedEnrollment
                              solve( RegistrySlot( ~device, ~pc, ~revision, 'active' ) ▶₀ #a )
                                case CaptureEligibleDevice
                                solve( !KU( ~pc ) @ #vk.11 )
                                  case CreatePc
                                  solve( !KU( ~epoch ) @ #vk.13 )
                                    case CreatePc
                                    solve( !KU( ~session_id ) @ #vk.15 )
                                      case CreatePc
                                      solve( !KU( ~logon_luid ) @ #vk.17 )
                                        case CreatePc
                                        solve( !KU( ~request_id ) @ #vk.19 )
                                          case PublishRequest
                                          solve( !KU( ~nonce ) @ #vk.21 )
                                            case PublishRequest
                                            solve( !KU( ~content_digest ) @ #vk.23 )
                                              case PublishRequest
                                              solve( !KU( ~expiry ) @ #vk.24 )
                                                case PublishRequest
                                                solve( !KU( ~device ) @ #vk.26 )
                                                  case SignDenialWithoutApprovalAuthentication
                                                  solve( !KU( sign(<
                                                                    'Windows-UAC-Remote-Controller/approve/v1',
                                                                    'v1', ~device, 'approve', ~pc, ~epoch,
                                                                    ~session_id, ~logon_luid, ~request_id,
                                                                    ~nonce, ~content_digest, ~expiry>,
                                                                   ~approval_sk)
                                                         ) @ #vk.29 )
                                                    case SignExactApprovalOnce
                                                    SOLVED // trace found
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed
