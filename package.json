{
  "name": "windows-uac-remote-controller",
  "version": "0.1.0-alpha.10",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "icons:generate": "node tools/generate-app-icons.mjs",
    "build": "tsc -b && vite build",
    "build:qa": "vite build --mode qa",
    "gallery": "playwright test --config playwright.gallery.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "lint": "eslint ui --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test:ui": "vitest run",
    "tauri": "tauri",
    "package:windows": "node tools/windows-packaging.mjs build",
    "inspect:windows-package": "node tools/windows-packaging.mjs inspect"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
