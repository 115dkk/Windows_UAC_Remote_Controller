{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "tsBuildInfoFile": "./target/typescript/node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.gallery.config.ts", "tools/ui-gallery/**/*.ts"]
}
